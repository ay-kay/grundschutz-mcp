# Copy to .env and fill in your values. Never commit the real .env file.
# All variables below have safe fallbacks; only edit what you need.

# ---------------------------------------------------------------------------
# Auth
# ---------------------------------------------------------------------------
# Empty = open server. The BSI content is public, so the default rate-limit
# (Traefik overlay) + container CPU cap is usually enough protection. To
# require a Bearer token, generate one with:
#
#   openssl rand -hex 32
#
# Note: Claude Desktop's web Custom-Connector UI does NOT currently support
# static Authorization headers; clients that do (the mcp-remote bridge,
# curl, etc.) will still work.
GRUNDSCHUTZ_AUTH_TOKEN=

# ---------------------------------------------------------------------------
# Operational tweaks (applies to every deployment mode)
# ---------------------------------------------------------------------------
GRUNDSCHUTZ_LOG_LEVEL=WARNING

# Container resource caps. Sensible if you share the host with other
# services. Comment out for an unconstrained container.
GRUNDSCHUTZ_CPU_LIMIT=4.0
GRUNDSCHUTZ_MEMORY_LIMIT=4G

# ---------------------------------------------------------------------------
# Standalone mode (compose.yml only)
# ---------------------------------------------------------------------------
# Host interface to bind the published port to. Default is loopback so
# the service is safe to run on a shared host. Set to 0.0.0.0 to expose
# 8080 publicly (without TLS, without auth unless you set the token
# above) - usually you want a reverse proxy in front instead.
BIND_HOST=127.0.0.1
HOST_PORT=8080

# MCP DNS-rebinding allowlist. Add your public hostname here if you reach
# the server through one. Empty defaults to localhost only.
# GRUNDSCHUTZ_ALLOWED_HOSTS=grundschutz.example.com,grundschutz.example.com:*,localhost,localhost:*

# ---------------------------------------------------------------------------
# Traefik overlay (compose.traefik.yml only)
# ---------------------------------------------------------------------------
# Required when you bring up the stack with
#   docker compose -f compose.yml -f compose.traefik.yml up -d
PUBLIC_HOST=grundschutz.example.com
PROXY_NETWORK=web
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERTRESOLVER=letsencrypt
# Optional: comma-separated middlewares (default is just the inline rate-limit).
# Append your own shared middlewares, e.g.:
# TRAEFIK_MIDDLEWARES=securityheaders,grundschutz-ratelimit
